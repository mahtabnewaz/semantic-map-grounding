# Copy to .env (gitignored) and fill in. Never inline a key in source.

# Groq — used only for the large-model comparison row.
# Multiple keys are optional; the client rotates on rate limits.
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# Ollama — primary, local. Default endpoint shown.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
